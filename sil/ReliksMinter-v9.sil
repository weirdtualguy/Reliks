pragma silverscript ^0.1.0;

// ReliksMinter-v9 — issuance controller (Phase 2 composition).
// KCC20Minter pattern, Reliks-shaped: holds series parameters + mints_left,
// spawns ReliksEdition instances via validateOutputStateWithTemplate against
// baked template metadata. The Edition template is foreign, so the spawn is
// manual cross-template routing; the Minter's OWN family is homogeneous 1:1 /
// 1:2 / 1:0, so every route is a DECL macro (no handwritten entries).
// Heterogeneous-spawn boundary (v6 lesson): the spawned Edition output is
// covenant-bound to the BUYER wallet input, keeping this input's
// authorized-output context at exactly its own continuation.
contract ReliksMinter(
    byte[32] init_program_hash,
    byte[32] init_artist,
    int init_price,
    int init_royalty_bips,
    int init_mints_left,
    byte[] edition_template_prefix,
    byte[] edition_template_suffix,
    byte[32] expected_template_hash
) {
    byte[32] program_hash = init_program_hash;
    byte[32] artist = init_artist;
    int price = init_price;
    int royalty_bips = init_royalty_bips;
    int mints_left = init_mints_left;

    byte constant IDENTIFIER_PUBKEY = 0x00;
    int constant PLATFORM_BIPS = 100;              // 1% protocol fee
    int constant MIN_PRICE = 500000000;   // 5 KAS mass-safe floor (F-B14)
    int constant MAX_PRICE = 922337203685477;      // i64 overflow guard
    // 50 KAS merged-creator-cut variant deferred (F-B14 OPEN list); separate fee outputs proven at 5-10 KAS with 1 KAS carriers.

    struct EditionState {
        byte[32] ownerIdentifier;
        byte identifierType;
        int price;
        byte[32] artist;
        int royalty_bips;
        byte[32] program_hash;
        byte[32] factory_covid;
        int serial;
    }

    // Outpoint-derived unique serial (v7/v8-proven pure-arithmetic LE63 form).
    function serialFromOutpoint(): int {
        byte[] domain = byte[]("ReliksSerialV9");
        byte[32] h = blake2b(domain + OpOutpointTxId(this.activeInputIndex) + (OpOutpointIndex(this.activeInputIndex) as byte[4]));
        int s = unsigned(h[0])
            + unsigned(h[1]) * 256
            + unsigned(h[2]) * 65536
            + unsigned(h[3]) * 16777216
            + unsigned(h[4]) * 4294967296
            + unsigned(h[5]) * 1099511627776
            + unsigned(h[6]) * 281474976710656
            + (unsigned(h[7]) % 128) * 72057594037927936;
        return s;
    }

    // Exact-equality primary split. Royalty is a secondary-market concept;
    // primary sale pays artist (price - fee) + platform fee, or a single
    // merged artist output below FEE_MERGE_THRESHOLD (F-B14).
    function checkPrimaryPayments(int artistOutIdx, int platformOutIdx) {
        if (price > 0) {
            byte[36] artistSpk = new ScriptPubKeyP2PK(pubkey(artist));
                        int fee = (price * PLATFORM_BIPS) / 10000;
            require(tx.outputs[artistOutIdx].value == price - fee);
            require(tx.outputs[artistOutIdx].scriptPubKey == byte[](artistSpk));
            require(tx.outputs[platformOutIdx].value == fee);
            require(tx.outputs[platformOutIdx].scriptPubKey == byte[](artistSpk));
        }
    }

    // Primary mint: decrement allowance, spawn one Edition (foreign template).
    #[covenant(binding = auth, from = 1, to = 1, mode = transition, name = mint)]
    function mintPolicy(State prev_state, byte[32] buyer, byte buyerScheme, int editionOutIdx, int artistOutIdx, int platformOutIdx) : (State) {
        require(mints_left > 0);
        require(price == 0 || (price >= MIN_PRICE && price <= MAX_PRICE));
        require(royalty_bips >= 0 && royalty_bips <= 9900);
        require(buyerScheme == IDENTIFIER_PUBKEY);
        checkPrimaryPayments(artistOutIdx, platformOutIdx);
        EditionState editionState = EditionState {
            ownerIdentifier: buyer,
            identifierType: buyerScheme,
            price: 0,
            artist: artist,
            royalty_bips: royalty_bips,
            program_hash: program_hash,
            factory_covid: OpInputCovenantId(this.activeInputIndex),
            serial: serialFromOutpoint()
        };
        validateOutputStateWithTemplate(
            editionOutIdx,
            editionState,
            edition_template_prefix,
            edition_template_suffix,
            expected_template_hash
        );
        return State {
            program_hash: program_hash,
            artist: artist,
            price: price,
            royalty_bips: royalty_bips,
            mints_left: mints_left - 1
        };
    }

    // Artist-signed conservative allowance split into two parallel lanes.
    #[covenant(binding = auth, from = 1, to = 2, mode = transition, name = fork)]
    function forkPolicy(State prev_state, sig artistSig, int leftMints, int rightMints) : (State[]) {
        require(checkSig(artistSig, pubkey(artist)));
        require(leftMints > 0 && rightMints > 0);
        require(leftMints + rightMints == mints_left);
        require(tx.outputs[OpAuthOutputIdx(this.activeInputIndex, 0)].value + tx.outputs[OpAuthOutputIdx(this.activeInputIndex, 1)].value >= tx.inputs[this.activeInputIndex].value);
        State[] nexts = State[]{};
        nexts = nexts.append(State {
            program_hash: program_hash, artist: artist, price: price,
            royalty_bips: royalty_bips, mints_left: leftMints
        });
        nexts = nexts.append(State {
            program_hash: program_hash, artist: artist, price: price,
            royalty_bips: royalty_bips, mints_left: rightMints
        });
        return nexts;
    }

    // Artist-signed termination: burn remaining allowance, recover carrier dust.
    #[covenant(binding = auth, from = 1, to = 1, mode = transition, termination = allowed, name = close)]
    function closePolicy(State prev_state, sig artistSig) : (State[]) {
        require(checkSig(artistSig, pubkey(artist)));
        return State[]{};
    }
}
