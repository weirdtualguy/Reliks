pragma silverscript ^0.1.0;
// Edition v3-final: Adds transfer, conditional royalties, keeps spend for dust recovery.
contract Edition(
    byte[32] init_owner, byte init_scheme, int init_price, byte[32] init_artist,
    int init_royalty_bips, byte[32] init_program_hash, byte[32] init_factory_covid, int init_serial
) {
    byte constant IDENTIFIER_PUBKEY = 0x00;
    byte[32] ownerIdentifier = init_owner; byte identifierType = init_scheme;
    int price = init_price; byte[32] artist = init_artist; int royalty_bips = init_royalty_bips;
    byte[32] program_hash = init_program_hash; byte[32] factory_covid = init_factory_covid; int serial = init_serial;

    function royaltyFloor(int salePrice, int bips): int {
        int q = salePrice / 10000; int r = salePrice % 10000;
        return q * bips + (r * bips) / 10000;
    }

    #[covenant(binding = auth, from = 1, to = 1, mode = transition)]
    function list(State prev, sig ownerSig, int newPrice) : (State) {
        require(prev.identifierType == IDENTIFIER_PUBKEY);
        require(checkSig(ownerSig, pubkey(prev.ownerIdentifier)));
        require(newPrice >= 0);
        return State { ownerIdentifier: prev.ownerIdentifier, identifierType: prev.identifierType,
            price: newPrice, artist: prev.artist, royalty_bips: prev.royalty_bips,
            program_hash: prev.program_hash, factory_covid: prev.factory_covid, serial: prev.serial };
    }

    // NEW: Free transfer (gifting/cold storage), clears price
    #[covenant(binding = auth, from = 1, to = 1, mode = transition)]
    function transfer(State prev, sig ownerSig, byte[32] newOwner, byte newScheme) : (State) {
        require(prev.identifierType == IDENTIFIER_PUBKEY);
        require(checkSig(ownerSig, pubkey(prev.ownerIdentifier)));
        require(newScheme == IDENTIFIER_PUBKEY);
        return State { ownerIdentifier: newOwner, identifierType: newScheme, price: 0,
            artist: prev.artist, royalty_bips: prev.royalty_bips,
            program_hash: prev.program_hash, factory_covid: prev.factory_covid, serial: prev.serial };
    }

    #[covenant(binding = auth, from = 1, to = 1, mode = transition)]
    function buy(State prev, byte[32] buyer, byte buyerScheme, int paymentOutIdx, int royaltyOutIdx) : (State) {
        require(prev.identifierType == IDENTIFIER_PUBKEY);
        require(buyerScheme == IDENTIFIER_PUBKEY);
        require(prev.price > 0);
        byte[] sellerSpk = byte[](new ScriptPubKeyP2PK(pubkey(prev.ownerIdentifier)));
        byte[] artistSpk = byte[](new ScriptPubKeyP2PK(pubkey(prev.artist)));
        require(tx.outputs[paymentOutIdx].value >= prev.price);
        require(tx.outputs[paymentOutIdx].scriptPubKey == sellerSpk);
        
        // Conditional royalty: only enforce if > 0 and owner != artist
        int royalty = royaltyFloor(prev.price, prev.royalty_bips);
        if (royalty > 0 && prev.ownerIdentifier != prev.artist) {
            require(tx.outputs[royaltyOutIdx].value >= royalty);
            require(tx.outputs[royaltyOutIdx].scriptPubKey == artistSpk);
        }
        return State { ownerIdentifier: buyer, identifierType: buyerScheme, price: 0,
            artist: prev.artist, royalty_bips: prev.royalty_bips,
            program_hash: prev.program_hash, factory_covid: prev.factory_covid, serial: prev.serial };
    }

    #[covenant(binding = auth, from = 1, to = 1, mode = transition)]
    function sell(State prev, sig ownerSig, byte[32] buyer, byte scheme, int askPrice, int paymentOutIdx, int royaltyOutIdx) : (State) {
        require(prev.identifierType == IDENTIFIER_PUBKEY);
        require(checkSig(ownerSig, pubkey(prev.ownerIdentifier)));
        require(scheme == IDENTIFIER_PUBKEY);
        require(askPrice > 0);
        byte[] sellerSpk = byte[](new ScriptPubKeyP2PK(pubkey(prev.ownerIdentifier)));
        byte[] artistSpk = byte[](new ScriptPubKeyP2PK(pubkey(prev.artist)));
        require(tx.outputs[paymentOutIdx].value >= askPrice);
        require(tx.outputs[paymentOutIdx].scriptPubKey == sellerSpk);
        
        int royalty = royaltyFloor(askPrice, prev.royalty_bips);
        if (royalty > 0 && prev.ownerIdentifier != prev.artist) {
            require(tx.outputs[royaltyOutIdx].value >= royalty);
            require(tx.outputs[royaltyOutIdx].scriptPubKey == artistSpk);
        }
        return State { ownerIdentifier: buyer, identifierType: scheme, price: 0,
            artist: prev.artist, royalty_bips: prev.royalty_bips,
            program_hash: prev.program_hash, factory_covid: prev.factory_covid, serial: prev.serial };
    }

    // KEPT: Dust recovery escape hatch
    entry spend(sig s) {
        require(identifierType == IDENTIFIER_PUBKEY);
        require(checkSig(s, pubkey(ownerIdentifier)));
    }
}
