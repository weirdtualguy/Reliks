pragma silverscript ^0.1.0;

contract OfferEscrow(
    byte[32] init_edition_covid,
    int init_amount,
    byte[32] init_offerer,
    int init_expire_age,
    int edition_prefix_len,
    int edition_suffix_len,
    byte[32] edition_template_hash
) {
    byte[32] edition_covid = init_edition_covid;
    int amount = init_amount;
    byte[32] offerer = init_offerer;
    int expire_age = init_expire_age;

    byte constant IDENTIFIER_PUBKEY = 0x00;

    struct EditionState {
        byte[32] ownerIdentifier;
        byte identifierType;
        int price;
        byte[32] artist;
        int royalty_bips;
        byte[32] program_hash;
        byte[32] factory_covid;
        int serial;
    }

    entry accept(int edition_idx, int owner_pay_idx, EditionState next_edition) {
        // The edition lineage must actually participate in this transaction.
        require(OpInputCovenantId(edition_idx) == edition_covid);
        require(OpCovOutputCount(edition_covid) == 1);
        int edition_out_idx = OpCovOutputIdx(edition_covid, 0);

        EditionState prev_edition = readInputStateWithTemplate(
            edition_idx,
            edition_prefix_len,
            edition_suffix_len,
            edition_template_hash
        );
        require(prev_edition.identifierType == IDENTIFIER_PUBKEY);

        // The edition must move to the offerer, unlisted.
        require(next_edition.ownerIdentifier == offerer);
        require(next_edition.identifierType == IDENTIFIER_PUBKEY);
        require(next_edition.price == 0);
        // Provenance fields are immutable across an offer accept.
        require(next_edition.artist == prev_edition.artist);
        require(next_edition.royalty_bips == prev_edition.royalty_bips);
        require(next_edition.program_hash == prev_edition.program_hash);
        require(next_edition.factory_covid == prev_edition.factory_covid);
        require(next_edition.serial == prev_edition.serial);

        validateOutputStateWithInputTemplate(
            edition_out_idx,
            next_edition,
            edition_idx,
            edition_prefix_len,
            edition_suffix_len,
            edition_template_hash
        );

        // The current edition owner receives exactly the escrowed value.
        require(tx.inputs[this.activeInputIndex].value >= amount);
        byte[36] owner_spk = new ScriptPubKeyP2PK(pubkey(prev_edition.ownerIdentifier));
        require(tx.outputs[owner_pay_idx].scriptPubKey == byte[](owner_spk));
        require(tx.outputs[owner_pay_idx].value == tx.inputs[this.activeInputIndex].value);
    }

    entry expire(int offerer_pay_idx) {
        // Permissionless liveness escape: anyone may refund the offerer
        // once the escrow UTXO is old enough. Silence never locks value.
        require(this.ageDaa >= expire_age);
        byte[36] offerer_spk = new ScriptPubKeyP2PK(pubkey(offerer));
        require(tx.outputs[offerer_pay_idx].scriptPubKey == byte[](offerer_spk));
        require(tx.outputs[offerer_pay_idx].value >= tx.inputs[this.activeInputIndex].value);
    }
}
