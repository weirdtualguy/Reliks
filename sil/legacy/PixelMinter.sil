pragma silverscript ^0.1.0;

contract PixelMinter(pubkey owner, byte[32] initTokenCovid, int initAmount, bool initInitialized, int templatePrefixLen, int templateSuffixLen, byte[32] expectedTemplateHash) {
    byte[32] tokenCovid = initTokenCovid;
    int amount = initAmount;
    bool initialized = initInitialized;

    struct TokenState {
        byte[32] ownerIdentifier;
        byte identifierType;
        int amount;
        bool isMinter;
    }

    byte constant IDENTIFIER_COVENANT_ID = 0x02;

    function calcInAmount(int tokenInputIdx): int {
        TokenState tokenPrevState = readInputStateWithTemplate(tokenInputIdx, templatePrefixLen, templateSuffixLen, expectedTemplateHash);
        return tokenPrevState.amount;
    }

    function checkMinterTokenNewState(TokenState minterTokenNewState, int tokenInputIdx) {
        byte[32] controllerId = OpInputCovenantId(this.activeInputIndex);
        require(minterTokenNewState.ownerIdentifier == controllerId);
        require(minterTokenNewState.identifierType == IDENTIFIER_COVENANT_ID);
        require(minterTokenNewState.isMinter);
        validateOutputStateWithInputTemplate(OpCovOutputIdx(tokenCovid, 0), minterTokenNewState, tokenInputIdx, templatePrefixLen, templateSuffixLen, expectedTemplateHash);
    }

    function checkRecipientTokenNewState(TokenState recipientTokenNewState, int tokenInputIdx) {
        require(!recipientTokenNewState.isMinter);
        validateOutputStateWithInputTemplate(OpCovOutputIdx(tokenCovid, 1), recipientTokenNewState, tokenInputIdx, templatePrefixLen, templateSuffixLen, expectedTemplateHash);
    }

    #[covenant.singleton]
    function init(State prevState, State newState, sig s) {
        require(!initialized);
        require(newState.tokenCovid == OpOutputCovenantId(0));
        require(newState.amount == prevState.amount);
        require(newState.initialized);
        require(checkSig(s, owner));
    }

    #[covenant.singleton]
    function mint(State prevState, State newState, sig s, TokenState minterTokenNewState, TokenState recipientTokenNewState) {
        require(initialized);
        require(newState.amount >= 0);
        require(newState.initialized);
        require(newState.tokenCovid == prevState.tokenCovid);
        require(OpCovOutputCount(tokenCovid) == 2);
        require(OpCovInputCount(tokenCovid) == 1);
        int tokenInputIdx = OpCovInputIdx(tokenCovid, 0);
        checkMinterTokenNewState(minterTokenNewState, tokenInputIdx);
        checkRecipientTokenNewState(recipientTokenNewState, tokenInputIdx);
        int inAmount = calcInAmount(tokenInputIdx);
        int mintedAmount = minterTokenNewState.amount + recipientTokenNewState.amount - inAmount;
        require(newState.amount == amount - mintedAmount);
        require(checkSig(s, owner));
    }
}
