pragma silverscript ^0.1.0;

contract SeriesFactory(
    byte[2048] program_art,
    byte[32] artist_id,
    int mint_price_sompi,
    int royalty_bips_val,
    int edition_cap,
    int init_counter,
    byte[] edition_template_prefix,
    byte[] edition_template_suffix,
    byte[32] expected_template_hash
) {
    byte[2048] art = program_art;
    byte[32] artist = artist_id;
    int price = mint_price_sompi;
    int royalty_bips = royalty_bips_val;
    int cap = edition_cap;
    int counter = init_counter;

    byte constant IDENTIFIER_PUBKEY = 0x00;

    struct EditionState {
        byte[32] ownerIdentifier;
        byte identifierType;
        int price;
        byte[32] artist;
        int royalty_bips;
        byte[32] program_hash;
        byte[32] factory_covid;
        int serial;
    }

    entry mint(byte[32] buyerIdentifier, int paymentOutIdx, int editionOutIdx) {
        require(counter < cap);

        byte[] artistSpk = byte[](new ScriptPubKeyP2PK(pubkey(artist)));
        require(tx.outputs[paymentOutIdx].value >= price);
        require(tx.outputs[paymentOutIdx].scriptPubKey == artistSpk);

        byte[32] programHash = blake2b(byte[](art));
        byte[32] factoryId = OpInputCovenantId(this.activeInputIndex);

        EditionState editionState = EditionState {
            ownerIdentifier: buyerIdentifier,
            identifierType: IDENTIFIER_PUBKEY,
            price: 0,
            artist: artist,
            royalty_bips: royalty_bips,
            program_hash: programHash,
            factory_covid: factoryId,
            serial: counter
        };

        validateOutputStateWithTemplate(
            editionOutIdx,
            editionState,
            edition_template_prefix,
            edition_template_suffix,
            expected_template_hash
        );

        byte[32] covId = OpInputCovenantId(this.activeInputIndex);
        require(OpCovOutputCount(covId) == 1);
        int factoryOutIdx = OpCovOutputIdx(covId, 0);
        validateOutputState(factoryOutIdx, State {
            art: art,
            artist: artist,
            price: price,
            royalty_bips: royalty_bips,
            cap: cap,
            counter: counter + 1
        });
    }
}
