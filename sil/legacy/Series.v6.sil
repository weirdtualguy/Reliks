pragma silverscript ^0.1.0;

contract Series(
    byte[2048] program_art,
    byte[32] artist_id,
    int mint_price_sompi,
    int royalty_bips_val,
    int edition_cap,
    byte init_role,
    int init_counter,
    byte[32] init_owner
) {
    byte constant ROLE_SERIES = 0x00;
    byte constant ROLE_EDITION = 0x01;
    byte constant IDENTIFIER_PUBKEY = 0x00;
    
    byte[2048] art = program_art;
    byte[32] artist = artist_id;
    int price = mint_price_sompi;
    int royalty_bips = royalty_bips_val;
    int cap = edition_cap;
    byte role = init_role;
    int counter = init_counter;
    byte[32] ownerIdentifier = init_owner;
    byte identifierType = IDENTIFIER_PUBKEY;

    #[covenant(binding = auth, mode = verification, from = 1, to = 2)]
    function mint(State prev_state, State[] new_states, byte[32] buyerIdentifier, byte buyerScheme, int paymentOutIdx, int feeOutIdx) {
        require(prev_state.role == ROLE_SERIES);
        require(prev_state.counter < prev_state.cap);

        byte[] artistSpk = byte[](new ScriptPubKeyP2PK(pubkey(prev_state.artist)));
        require(tx.outputs[paymentOutIdx].value >= prev_state.price);
        require(tx.outputs[paymentOutIdx].scriptPubKey == artistSpk);

        // FIX: Explicitly cast the hex literal to byte[32]
        byte[32] treasury = byte[32](0x33fe25d181460cec565e08ceef80761c2cb990d595f43193a0c76237b0d9cc68);
        byte[] treasurySpk = byte[](new ScriptPubKeyP2PK(pubkey(treasury)));
        require(tx.outputs[feeOutIdx].value >= 100000000);
        require(tx.outputs[feeOutIdx].scriptPubKey == treasurySpk);

        require(new_states.length == 2);
        require(new_states[0].role == ROLE_EDITION);
        require(new_states[0].counter == prev_state.counter);
        require(new_states[0].ownerIdentifier == buyerIdentifier);
        require(new_states[1].role == ROLE_SERIES);
        require(new_states[1].counter == prev_state.counter + 1);
        require(new_states[1].royalty_bips == prev_state.royalty_bips);
    }

    #[covenant.singleton(mode = transition)]
    function list(State prev_state, sig ownerSig, int newPrice, int newBips) : (State) {
        require(prev_state.role == ROLE_EDITION);
        require(prev_state.identifierType == IDENTIFIER_PUBKEY);
        require(checkSig(ownerSig, pubkey(prev_state.ownerIdentifier)));
        require(newPrice >= 0);
        require(newBips >= 0);
        require(newBips <= 10000);
        return State { art: prev_state.art, artist: prev_state.artist, price: newPrice, royalty_bips: newBips, cap: prev_state.cap,
            role: ROLE_EDITION, counter: prev_state.counter,
            ownerIdentifier: prev_state.ownerIdentifier, identifierType: prev_state.identifierType };
    }

    #[covenant.singleton(mode = transition)]
    function buy(State prev_state, byte[32] buyerIdentifier, byte buyerScheme, int paymentOutIdx, int royaltyOutIdx) : (State) {
        require(prev_state.role == ROLE_EDITION);
        require(prev_state.price > 0);
        
        byte[] sellerSpk = byte[](new ScriptPubKeyP2PK(pubkey(prev_state.ownerIdentifier)));
        byte[] artistSpk = byte[](new ScriptPubKeyP2PK(pubkey(prev_state.artist)));
        
        require(tx.outputs[paymentOutIdx].value >= prev_state.price);
        require(tx.outputs[paymentOutIdx].scriptPubKey == sellerSpk);
        require(tx.outputs[royaltyOutIdx].value * 10000 >= prev_state.price * prev_state.royalty_bips);
        require(tx.outputs[royaltyOutIdx].scriptPubKey == artistSpk);
        
        return State { art: prev_state.art, artist: prev_state.artist, price: 0, royalty_bips: prev_state.royalty_bips, cap: prev_state.cap,
            role: ROLE_EDITION, counter: prev_state.counter,
            ownerIdentifier: buyerIdentifier, identifierType: buyerScheme };
    }

    #[covenant.singleton(mode = transition)]
    function sell(State prev_state, sig ownerSig, byte[32] buyerIdentifier, byte buyerScheme, int askPrice, int paymentOutIdx) : (State) {
        require(prev_state.role == ROLE_EDITION);
        require(prev_state.identifierType == IDENTIFIER_PUBKEY);
        require(checkSig(ownerSig, pubkey(prev_state.ownerIdentifier)));
        byte[] sellerSpk = byte[](new ScriptPubKeyP2PK(pubkey(prev_state.ownerIdentifier)));
        require(tx.outputs[paymentOutIdx].value >= askPrice);
        require(tx.outputs[paymentOutIdx].scriptPubKey == sellerSpk);
        return State { art: prev_state.art, artist: prev_state.artist, price: 0, royalty_bips: prev_state.royalty_bips, cap: prev_state.cap,
            role: ROLE_EDITION, counter: prev_state.counter,
            ownerIdentifier: buyerIdentifier, identifierType: buyerScheme };
    }

    entry spend(sig s, int witness) {
        require(role == ROLE_EDITION);
        require(identifierType == IDENTIFIER_PUBKEY);
        require(checkSig(s, pubkey(ownerIdentifier)));
    }
}
