pragma silverscript ^0.1.0;

contract Series(
    byte[2048] program_art,
    byte[32] artist_id,
    int mint_price_sompi,
    int royalty_bips_val,
    int edition_cap,
    int init_counter,
    byte[32] edition_covid,
    byte[] edition_template_prefix,
    byte[] edition_template_suffix,
    byte[32] expected_template_hash
) {
    byte constant ROLE_SERIES = 0x00;
    byte constant ROLE_EDITION = 0x01;
    byte constant IDENTIFIER_PUBKEY = 0x00;

    byte[2048] art = program_art;
    byte[32] artist = artist_id;
    int price = mint_price_sompi;
    int royalty_bips = royalty_bips_val;
    int cap = edition_cap;
    int counter = init_counter;
    byte[32] edition_covenant = edition_covid;
    byte[] tmpl_prefix = edition_template_prefix;
    byte[] tmpl_suffix = edition_template_suffix;
    byte[32] tmpl_hash = expected_template_hash;

    struct EditionState {
        byte[32] ownerIdentifier;
        byte identifierType;
        int price;
        byte[32] programHash;
        byte[32] artist;
        int royalty_bips;
        int serial;
    }

    #[covenant.singleton(mode = transition)]
    function mint(State prev_state, byte[32] buyer, byte buyerScheme, int paymentOutIdx, int editionOutIdx) : (State) {
        require(prev_state.counter < prev_state.cap);
        require(prev_state.royalty_bips >= 0);
        require(prev_state.royalty_bips <= 10000);

        byte[] artistSpk = byte[](new ScriptPubKeyP2PK(pubkey(prev_state.artist)));
        require(tx.outputs[paymentOutIdx].value >= prev_state.price);
        require(tx.outputs[paymentOutIdx].scriptPubKey == artistSpk);

        byte[32] programHash = blake2b(byte[](prev_state.art));

        EditionState editionState = EditionState {
            ownerIdentifier: buyer,
            identifierType: buyerScheme,
            price: 0,
            programHash: programHash,
            artist: prev_state.artist,
            royalty_bips: prev_state.royalty_bips,
            serial: prev_state.counter
        };

        validateOutputStateWithTemplate(
            editionOutIdx,
            editionState,
            prev_state.tmpl_prefix,
            prev_state.tmpl_suffix,
            prev_state.tmpl_hash
        );

        return State {
            art: prev_state.art,
            artist: prev_state.artist,
            price: prev_state.price,
            royalty_bips: prev_state.royalty_bips,
            cap: prev_state.cap,
            counter: prev_state.counter + 1,
            edition_covenant: prev_state.edition_covenant,
            tmpl_prefix: prev_state.tmpl_prefix,
            tmpl_suffix: prev_state.tmpl_suffix,
            tmpl_hash: prev_state.tmpl_hash
        };
    }
}
