palette("#0b0b0f", "#f5f5f5", "#dc2828", "#ff8fa3", "#1b1b1b", "#7bd05f");
fill(0);
for 3 {
  let r = rint(2, 5);
  let y = rint(3, 12);
  let x = rint(2, 7);
  let c = pick(1, 2, 3, 5);
  mirrorc(x, y, r, c);
}
for 24 {
  dot(rint(0, 15), rint(0, 15), pick(1, 2, 3));
}
circle(8, 8, rint(1, 2), 4);
