palette("#0b0b0f", "#f5f5f5", "#dc2828", "#ff8fa3", "#7bd05f", "#3aa0ff");
col(0); fill();
let i = 0;
for 8 {
  hsl(560 + i * 50, 420, 90 + i * 26);
  rect(0, i * 128, 1024, 128);
  i = i + 1;
}
sym(6) {
  let a = rint(80, 300);
  let b = rint(200, 480);
  col(pick(2, 3, 4, 5));
  line(512, 512, 512 + a, 512 - b, rint(6, 22));
  circle(512 + a, 512 - b, rint(10, 40));
  if n2(a, b) > 512 { ring(512 + a / 2, 512 - b / 2, rint(20, 60)); }
}
mirror {
  for 14 {
    col(pick(1, 3, 5));
    dot(rint(60, 440), rint(60, 960), rint(4, 14));
  }
}
col(1); ring(512, 512, 60 + frame() * 40);
