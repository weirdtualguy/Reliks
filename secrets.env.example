# Copy to secrets.env (gitignored) and `set -a; . ./secrets.env; set +a`.
# Never commit real keys. Use freshly generated keys for mainnet.
PC_NET=testnet                 # testnet | mainnet
PC_PRIV=                       # 64-hex private key
PC_WALLET=                     # address derived from PC_PRIV (checked at startup)
# mainnet only: trusted wRPC endpoint(s), comma-separated (covenant spends cannot use REST)
# PC_MAINNET_WRPC=ws://localhost:17110
# optional overrides (defaults target the v12 mainnet engine and data/*-v12.json)
# RELIKS_ENGINE=./reliks-engine-mainnet.js
# RELIKS_ARGS=data/factory-args-v12.json
# RELIKS_LEDGER=data/factory-ledger-v12.json
# RELIKS_FACTORY_ABI=data/factory-abi-v12.json
