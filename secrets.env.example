# Reliks secrets — TESTNET ONLY unless explicitly configured for mainnet.
# Copy to secrets.env, fill in your own values, and NEVER commit that file.
# Mainnet migration must use freshly generated keys loaded from env, not files.
PC_NETWORK=testnet-10
PC_PRIV=                 # 64-hex private key. NEVER hardcode this anywhere else.
PC_WALLET=                # kaspatest:... address matching PC_PRIV
PC_ARTIST_PUB=             # 64-hex artist pubkey for series economics
PC_FUND_ADDR=              # kaspatest:... funding address for deploy/mint fees
PC_RPC_1=wss://electron-10.kaspa.stream/kaspa/testnet-10/wrpc/json
PC_RPC_2=wss://vector-10.kaspa.green/kaspa/testnet-10/wrpc/json
PC_REST=https://api-tn10.kaspa.org
PC_INDEXER=https://kascov.io/data/testnet-10
