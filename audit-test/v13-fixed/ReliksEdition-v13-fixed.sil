pragma silverscript ^0.1.0;

// sell's zero-price branch removed (use transfer). Verified with silverc 2026-11-14
// (template 9106b1426f4bb67ba4133d040b5258a9f177939c338266d249a1f8780e0ea2e5).
// Fixes applied 2026-11-14 (audit: C1 binding, H1 contiguous payments,
// M1 royalty floor 5M; M3 mitigated by the escrow `cancel` entry — the
// `age < expireAge` bound itself is not expressible in silverc 0.1.0,
// `<` does not apply to temporal; see OfferEscrow-v6-fixed.sil and the
// audit report). Serials are counter-based (M2): the factory's
// `next_serial` assigns each edition `serial`, and
// lineage = blake2b("ReliksGenesisV2" + factory_covid + LE8(serial)).
// State span 203.
// ReliksEdition-v13 (FINAL) — pure NFT asset state machine (Zero-Fee Protocol).
// v12 changes: Logic identical to v11. v11 already enforced a royalty-only split
// (owner + artist), which aligns perfectly with the v12 zero-fee model.
// Version bump required for fresh genesis and template hash rotation.
contract ReliksEdition(
    byte[32] init_owner,
    byte init_scheme,
    int init_price,
    byte[32] init_artist,
    int init_royalty_bips,
    byte[32] init_program_hash,
    byte[32] init_factory_covid,
    int init_serial,
    byte[32] init_lineage,
    int init_sales
) {
    byte[32] ownerIdentifier = init_owner;
    byte identifierType = init_scheme;
    int price = init_price;
    byte[32] artist = init_artist;
    int royalty_bips = init_royalty_bips;
    byte[32] program_hash = init_program_hash;
    byte[32] factory_covid = init_factory_covid;
    int serial = init_serial;
    byte[32] lineage = init_lineage;
    int sales = init_sales;

    byte constant IDENTIFIER_PUBKEY = 0x00;
    int constant MIN_PRICE = 100000000;       // 1 KAS listing floor
    int constant MAX_PRICE = 922337203685477; // i64 overflow guard for price*bips
    int constant MIN_ROYALTY_OUT = 5000000; // 0.05 KAS royalty floor (M1 fix 2026-11-14; mainnet cap inferred from source and TN10 2026-11-14: 500,000 mass, not 100k — see audit report. Measured boundary at 1 KAS is ~2.2M sompi; 5M gives ~2x margin. At 5% royalty the minimum listable price is 1 KAS.)

    function ownerAuthorized(sig ownerSig) {
        require(identifierType == IDENTIFIER_PUBKEY);
        require(checkSig(ownerSig, pubkey(ownerIdentifier)));
    }

    // Royalty-only exact-equality split.
    // H1 fix (2026-11-14): payment outputs must sit immediately after this
    // input's authorized output, so one payment pair cannot satisfy two inputs.
    function checkPayments(int salePrice, int ownerOutIdx, int artistOutIdx) {
        require(identifierType == IDENTIFIER_PUBKEY);
        require(ownerOutIdx != artistOutIdx);
        int base = OpAuthOutputIdx(this.activeInputIndex, 0);
        require(ownerOutIdx == base + 1 && artistOutIdx == base + 2);
        int roy = (salePrice * royalty_bips) / 10000;
        int ownerNet = salePrice - roy;
        require(ownerNet >= 0);
        byte[36] artistSpk = new ScriptPubKeyP2PK(pubkey(artist));
        byte[36] ownerSpk = new ScriptPubKeyP2PK(pubkey(ownerIdentifier));
        require(tx.outputs[ownerOutIdx].value >= ownerNet);
        require(tx.outputs[ownerOutIdx].scriptPubKey == byte[](ownerSpk));
        require(tx.outputs[artistOutIdx].value == roy);
        require(tx.outputs[artistOutIdx].scriptPubKey == byte[](artistSpk));
    }

    function clearedState(byte[32] newOwner): State {
        return State {
            ownerIdentifier: newOwner,
            identifierType: IDENTIFIER_PUBKEY,
            price: 0,
            artist: artist,
            royalty_bips: royalty_bips,
            program_hash: program_hash,
            factory_covid: factory_covid,
            serial: serial,
            lineage: lineage,
            sales: sales
        };
    }

    // Royalty-paying ownership change: advances patina input and wear.
    function soldState(byte[32] newOwner): State {
        byte[] domain = byte[]("ReliksLineageV2");
        return State {
            ownerIdentifier: newOwner,
            identifierType: IDENTIFIER_PUBKEY,
            price: 0,
            artist: artist,
            royalty_bips: royalty_bips,
            program_hash: program_hash,
            factory_covid: factory_covid,
            serial: serial,
            lineage: blake2b(domain + lineage + newOwner),
            sales: sales + 1
        };
    }

    // Free handover: advances lineage (provenance) but NOT sales (royalty-paying sales only).
    function movedState(byte[32] newOwner): State {
        byte[] domain = byte[]("ReliksLineageV2");
        return State {
            ownerIdentifier: newOwner,
            identifierType: IDENTIFIER_PUBKEY,
            price: 0,
            artist: artist,
            royalty_bips: royalty_bips,
            program_hash: program_hash,
            factory_covid: factory_covid,
            serial: serial,
            lineage: blake2b(domain + lineage + newOwner),
            sales: sales
        };
    }

    // Carrier value conservation: edition output >= edition input
    function carrierConserved() {
        int outIdx = OpAuthOutputIdx(this.activeInputIndex, 0);
        require(tx.outputs[outIdx].value >= tx.inputs[this.activeInputIndex].value);
    }

    #[covenant(binding = auth, from = 1, to = 1, mode = transition, name = list)]
    function listPolicy(State prev_state, int newPrice, sig ownerSig) : (State) {
        ownerAuthorized(ownerSig);
        carrierConserved();
        require(newPrice >= MIN_PRICE && newPrice <= MAX_PRICE);
        // M1 fix (2026-11-14): the royalty this listing would pay must clear
        // the mineability floor, else buy can never be mined.
        require((newPrice * royalty_bips) / 10000 >= MIN_ROYALTY_OUT);
        return State {
            ownerIdentifier: prev_state.ownerIdentifier,
            identifierType: prev_state.identifierType,
            price: newPrice,
            artist: prev_state.artist,
            royalty_bips: prev_state.royalty_bips,
            program_hash: prev_state.program_hash,
            factory_covid: prev_state.factory_covid,
            serial: prev_state.serial,
            lineage: prev_state.lineage,
            sales: prev_state.sales
        };
    }

    #[covenant(binding = auth, from = 1, to = 1, mode = transition, name = unlist)]
    function unlistPolicy(State prev_state, sig ownerSig) : (State) {
        ownerAuthorized(ownerSig);
        carrierConserved();
        return clearedState(prev_state.ownerIdentifier);
    }

    #[covenant(binding = auth, from = 1, to = 1, mode = transition, name = buy)]
    function buyPolicy(State prev_state, byte[32] buyer, int ownerOutIdx, int artistOutIdx) : (State) {
        require(price > 0);
        require(price <= MAX_PRICE);
        carrierConserved();
        checkPayments(price, ownerOutIdx, artistOutIdx);
        return soldState(buyer);
    }

    #[covenant(binding = auth, from = 1, to = 1, mode = transition, name = sell)]
    function sellPolicy(State prev_state, byte[32] buyer, int salePrice, int ownerOutIdx, int artistOutIdx, sig ownerSig) : (State) {
        ownerAuthorized(ownerSig);
        carrierConserved();
        require(salePrice >= MIN_PRICE && salePrice <= MAX_PRICE);
        // M1 fix (2026-11-14): same royalty floor as list.
        require((salePrice * royalty_bips) / 10000 >= MIN_ROYALTY_OUT);
        checkPayments(salePrice, ownerOutIdx, artistOutIdx);
        return soldState(buyer);
    }

    #[covenant(binding = auth, from = 1, to = 1, mode = transition, name = transfer)]
    function transferPolicy(State prev_state, byte[32] newOwner, sig ownerSig) : (State) {
        ownerAuthorized(ownerSig);
        carrierConserved();
        return movedState(newOwner);
    }

    #[covenant(binding = auth, from = 1, to = 1, mode = transition, termination = allowed, name = spend)]
    function spendPolicy(State prev_state, sig ownerSig) : (State[]) {
        ownerAuthorized(ownerSig);
        return State[]{};
    }
}
