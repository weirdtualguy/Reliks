  "license": "MIT",
  "private": false,
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weirdtualguy/Reliks.git"
  },
  "bugs": {
    "url": "https://github.com/weirdtualguy/Reliks/issues"
  },
  "homepage": "https://github.com/weirdtualguy/Reliks#readme",
  "keywords": [
    "kaspa",
    "nft",
    "generative-art",
    "covenants",
    "utxo",
    "blockdag",
    "reliks-vm"
  ],
  "scripts": {
    "test": "node test/self-test.js && node test/chain-test.js && node test/codec-test.js && node test/wallet-test.js && node test/site-test.js && node test/kaspire-mass-test.js && node test/asm-test.js && node test/studio-test.js && node test/vm-conformance-test.js && node test/marketplace-test.js",
    "args": "node cli/gen-factory-args.js",
    "deploy": "node cli/deploy.js",
    "mint": "node cli/mint.js",
    "secondary": "node cli/secondary.js",
    "offer": "node cli/offer.js",
    "accept": "node cli/accept.js",
    "cancel": "node cli/cancel.js",
    "expire": "node cli/expire.js",
    "verify": "node cli/verify-render.js",
    "gallery": "node cli/gen-gallery.js",
    "site": "node tools/gen-site.js",
    "lens": "node cli/reliks-lens.js",
    "studio": "node tools/gen-studio.js",
    "bundle": "node tools/gen-provenance-bundle.js",
    "bundle:verify": "node tools/gen-provenance-bundle.js --verify",
    "sync:market": "node tools/sync-marketplace.js",
    "submit:series": "node tools/verify-and-add-series.js"
  },
  "dependencies": {
    "@noble/curves": "^1.6.0",
    "@noble/hashes": "^1.8.0",
    "ws": "^8.21.3"
  }
