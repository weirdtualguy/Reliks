# Dependencies
node_modules/

# Local state and caches (Regenerable from on-chain data)
data/*-ledger*.json
data/*-args*.json
data/series-*.json
# Fixed, zero-value template-compile args (not per-deployment state — safe to track)
!data/edition-args.json
!data/escrow-args.json
!data/examples/*.json

# Secrets and Environment Variables
*.env
secrets*.env

# Generated Outputs (regenerable — gallery via gen-gallery.js)
/reliks-gallery-*.html
*.svg
# docs/index.html is tracked on purpose: GitHub Pages serves it directly,
# and `npm test` (test/site-test.js) fails the build if it ever drifts
# from what `npm run site` produces.

# Internal engineering notes — not for public release
HANDOFF-LOCAL.md
HANDOFF.md

